# ===========================================
# Agency Content Pipeline — Environment Config
# ===========================================
# Copy this file to .env and fill in your values.
# Run 'python -m src.config' to verify your setup.

# ------ REQUIRED ------

# Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# WordPress site URL (include https:// or http://)
WP_SITE_URL=http://your-site.local

# WordPress username (the account that owns the Application Password)
WP_USERNAME=admin

# WordPress Application Password
# Create one at: WP Admin → Users → Your Profile → Application Passwords
# Looks like: xxxx xxxx xxxx xxxx xxxx xxxx
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# ------ OPTIONAL ------

# Google Docs integration (pipeline works without this — uses local .md files)
# Path to a Google service account JSON key file
# GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/service-account.json

# Slack notification (webhook URL for completion alerts)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../xxx

# Email notification via SendGrid
# SENDGRID_API_KEY=SG.xxx
# NOTIFICATION_EMAIL=you@example.com
